# Mẫu .env cho bản cài bằng deploy/install.sh. install.sh sao chép file này thành .env rồi điền các giá trị trống
# (APP_KEY, DB_PASSWORD, INSTALL_TOKEN, APP_VERSION, APP_IMAGE, UPDATER_IMAGE, INSTALL_DIR, APP_URL, APP_DOMAIN).
# Cấu hình SMTP, Google, SePay KHÔNG nằm ở đây: nhập trong wizard /install hoặc Admin → Cài đặt.
APP_NAME="SMM Panel"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
APP_DOMAIN=
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# Phiên bản đang chạy (tag cụ thể, không dùng "latest") và image theo digest, do install.sh/updater ghi.
APP_VERSION=
APP_IMAGE=
UPDATER_IMAGE=

# Mã mở wizard /install; vô hiệu sau khi cài xong. Có thể xoá dòng này sau khi cài.
INSTALL_TOKEN=
INSTALL_DIR=/opt/smm-panel
BACKUP_DIR=/srv/backups/smm-panel

# Trạng thái bảo trì dùng chung mọi container, sống qua lúc tạo lại container
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smm_panel
DB_USERNAME=smm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Subnet mạng compose (Caddy = 172.30.0.10)
TRUSTED_PROXIES=172.30.0.0/24

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
