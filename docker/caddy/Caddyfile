# TLS Let's Encrypt tự động. Caddy mặc định KHÔNG tin X-Forwarded-For từ client → app nhận IP thật qua trusted proxy.
# Nếu đặt Cloudflare phía trước: thêm `servers { trusted_proxies static <dải IP Cloudflare> }` trong global options.
{$APP_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    reverse_proxy app:8080
}
