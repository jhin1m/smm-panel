APP_NAME="SMM Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_DOMAIN=example.com

# Image chạy. Tự build từ source: smm-panel:local + `docker compose -f compose.yml -f compose.build.yml up -d --build`.
# Cài bằng deploy/install.sh thì dùng .env.template (APP_IMAGE là digest do install.sh ghi).
APP_IMAGE=smm-panel:local

# Thư mục nhận backup (docker/backup/backup-db.sh đọc khoá này)
BACKUP_DIR=/srv/backups/smm-panel

# Mã mở wizard /install khi DB chưa có admin (instance đã có admin được đánh dấu đã cài tự động)
INSTALL_TOKEN=
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

# Trạng thái bảo trì dùng chung mọi container, sống qua lúc tạo lại container
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smm_panel
DB_USERNAME=smm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Subnet mạng compose (Caddy = 172.30.0.10)
TRUSTED_PROXIES=172.30.0.0/24

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
# Trống = danh sách IP mặc định trong config/sepay.php (chỉ để log cảnh báo)
SEPAY_ALLOWED_IPS=
